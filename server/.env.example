# =====================================================================
# Copie ce fichier en « .env » (même dossier) et remplis les valeurs.
# Le fichier .env n'est JAMAIS envoyé sur GitHub (il est dans .gitignore).
# =====================================================================

# Mode : development (sur ton ordinateur) ou production (sur le serveur)
NODE_ENV=development
# Port de l'API (le frontend en développement y envoie ses requêtes)
PORT=4000

# --- Connexion MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mapetitecoree
DB_USER=mapetitecoree_app
DB_PASSWORD=change-moi-mot-de-passe-mysql

# --- Sécurité de la connexion admin ---
# Une longue phrase aléatoire (64 caractères conseillés). Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplace-moi-par-une-valeur-aleatoire-tres-longue
# Durée d'une session admin, en heures
ADMIN_SESSION_HOURS=8
# true = cookie envoyé seulement en HTTPS (obligatoire en production, false en local http://)
COOKIE_SECURE=false
# true si l'API est derrière un proxy (Nginx, hébergeur) qui transmet l'IP réelle
TRUST_PROXY=false

# Taille max d'une photo produit envoyée depuis l'admin (Mo)
MAX_UPLOAD_MB=5
